<?xml version="1.0" encoding="UTF-8"?>
<!--
  Graphiti-Java 生产环境日志配置
  - 输出到 stdout (由 Docker log driver 收集)
  - JSON 格式 (便于日志聚合系统解析)
  - 滚动策略: 按日期 + 大小滚动，保留 30 天
-->
<configuration>
    <!-- 生产环境使用 JSON 格式 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Spring Boot 基础模式 -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>

    <!-- JSON 格式 (生产推荐，使用 logstash-logback-encoder 时启用) -->
    <!-- 如需 JSON 格式，取消注释以下依赖并配置 encoder -->
    <!--
    <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
        <version>7.4</version>
    </dependency>
    -->

    <!-- Console Appender - 输出到 stdout (Docker log driver) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- File Appender - 滚动日志文件 (保留 30 天) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/app/logs/graphiti-java.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 每天滚动，按大小 (100MB) 滚动，保留 30 天 -->
            <fileNamePattern>/app/logs/graphiti-java.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 异步 Appender (提升写入性能) -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- Spring Boot 生产 profile -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- 开发 profile -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- 第三方库日志级别调优 -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.springframework.boot.actuate" level="INFO"/>
    <logger name="org.neo4j.driver" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="com.graphiti" level="INFO"/>
</configuration>
