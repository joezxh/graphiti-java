# ============================================================
# OntoGraph 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
# ============================================================

# ---------------------------------------------
# Spring Profile (dev | prod)
# ---------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------
# PostgreSQL 配置
# ---------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ---------------------------------------------
# Redis 配置 (默认即可)
# ---------------------------------------------
REDIS_PASSWORD=

# ---------------------------------------------
# Neo4j 配置 (外部服务)
# ---------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ---------------------------------------------
# LLM Provider 选择
# ---------------------------------------------
# 可选值: openai | qwen | ollama | anthropic | mistral | deepseek | groq | fireworks | nebius | hyperbolic | siliconflow
ONTOGRAPH_AI_LLM_PROVIDER=openai
ONTOGRAPH_AI_EMBEDDING_PROVIDER=openai
ONTOGRAPH_AI_RERANK_PROVIDER=custom

# ---------------------------------------------
# OpenAI 配置
# ---------------------------------------------
SPRING_AI_OPENAI_API_KEY=your_openai_api_key_here
SPRING_AI_OPENAI_BASE_URL=
# SPRING_AI_OPENAI_CHAT_MODEL=gpt-4o
# SPRING_AI_OPENAI_TEMPERATURE=0.2

# ---------------------------------------------
# Azure OpenAI 配置 (如使用)
# ---------------------------------------------
# SPRING_AI_AZURE_OPENAI_API_KEY=your_azure_api_key
# SPRING_AI_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# ---------------------------------------------
# Ollama 本地配置 (如使用)
# ---------------------------------------------
# SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434
# ONTOGRAPH_AI_OLLAMA_CHAT_MODEL=llama3.2
# ONTOGRAPH_AI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------
# 通义千问配置 (如使用)
# ---------------------------------------------
# ONTOGRAPH_AI_QWEN_API_KEY=your_qwen_api_key
# ONTOGRAPH_AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------------------------------------------
# DeepSeek 配置 (如使用)
# ---------------------------------------------
# SPRING_AI_DEEPSEEK_API_KEY=your_deepseek_api_key

# ---------------------------------------------
# JWT 配置
# ---------------------------------------------
JWT_SECRET=your_secure_jwt_secret_here_min_512_bits
JWT_EXPIRATION=86400

# ---------------------------------------------
# 日志级别
# ---------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_GRAPHTI=DEBUG

# ---------------------------------------------
# 其他配置
# ---------------------------------------------
# 最大内存 (JVM -Xmx)
# JAVA_OPTS=-Xms512m -Xmx1536m
